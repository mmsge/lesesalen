# Lesesalen needs no secrets: there is no login on the server side, no API keys and
# no third-party services. Everything below is optional tuning with a sane default
# baked in, listed here so a single-repo agent — and a new-box migration — can see
# the whole surface.
#
# Where SQLite + cover files live (the Compose volume mounts /data).
# LESESALEN_DATA_DIR=/data
#
# Public origin: used for absolute URLs and for the User-Agent we present to the
# BookWyrm instances we fetch from.
# LESESALEN_BASE_URL=https://lesesalen.msge.no
#
# Enrichment cache: entries and seconds. In memory only, never on disk (ADR 0005).
# LESESALEN_ENRICH_CACHE_SIZE=2000
# LESESALEN_ENRICH_CACHE_TTL=3600
#
# How long a nodeinfo probe is trusted before re-probing (seconds; default 30 days).
# LESESALEN_INSTANCE_TTL=2592000
#
# Per-IP token bucket on the API: sustained requests/second and burst size.
# LESESALEN_RATE_PER_SEC=2
# LESESALEN_RATE_BURST=40
#
# Politeness to origin instances: minimum seconds between requests to any one domain.
# LESESALEN_DOMAIN_INTERVAL=1.0
#
# Set to 1 to allow fetching private/loopback addresses. LOCAL TESTING ONLY — with
# this on, /api/berik is an SSRF hole into the box (ADR 0003).
# LESESALEN_ALLOW_PRIVATE_ADDRESSES=0
